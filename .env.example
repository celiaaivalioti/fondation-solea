NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-09

# Outgoing mail for the contact and registration forms (Infomaniak mailbox).
# Set these in the Node.js hosting environment variables in production.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=contact@fondation-solea.ch
SMTP_PASSWORD=the-mailbox-password
CONTACT_FORM_TO=contact@fondation-solea.ch

# Stripe donations: GitHub Actions secrets are forwarded to Infomaniak at deploy.
# For local testing, set test credentials in .env.local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SITE_URL=http://localhost:3000
# Optional locally; production uses /srv/customer/solea-donations outside deploys.
STRIPE_DONATION_STORE_PATH=
# Sandbox certificates go only to this mailbox. Empty = no sandbox emails.
# GitHub Actions repository secret or variable; the secret takes precedence.
STRIPE_DONATION_TEST_EMAIL=
